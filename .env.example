# SurrealDB Agent Memory
# Endpoint origin without a trailing slash, the context id, and an API key for it.
EXPO_PUBLIC_MEMORY_ENDPOINT=
EXPO_PUBLIC_MEMORY_CONTEXT=
EXPO_PUBLIC_MEMORY_API_KEY=
# Optional: model override for Agent Memory chat.
EXPO_PUBLIC_MEMORY_CHAT_MODEL=

# Gradium Phonon bridge page (npm run bridge). Must be https or localhost.
# iOS simulator: http://localhost:5180
# Android emulator: http://localhost:5180 after `adb reverse tcp:5180 tcp:5180`
# Physical device: an https deployment of phonon-bridge/dist, or a tunnel.
EXPO_PUBLIC_PHONON_BRIDGE_URL=http://localhost:5180
